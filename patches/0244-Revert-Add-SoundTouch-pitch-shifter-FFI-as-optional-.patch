From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: fukiame <fukiame@proton.me>
Date: Thu, 30 Jul 2026 18:06:22 +0700
Subject: [PATCH] Revert "Add SoundTouch pitch shifter FFI as optional
 native_audio dependency"

This reverts commit 5bb2b8bd5b81fdb6c88b0a4da7dbcc25f8c9c5c0.

diff --git a/rust/Cargo.toml b/rust/Cargo.toml
index c76d560c..1940c985 100644
--- a/rust/Cargo.toml
+++ b/rust/Cargo.toml
@@ -9,7 +9,7 @@ crate-type = ["cdylib", "staticlib", "rlib"]
 [features]
 default = ["native_audio", "uac2"]
 # Enable native audio engine (now enabled on Android with CPAL/Oboe)
-native_audio = ["cpal", "symphonia", "rubato", "ringbuf", "crossbeam-channel", "wavpack-sys", "opus-sys", "soundtouch-sys"]
+native_audio = ["cpal", "symphonia", "rubato", "ringbuf", "crossbeam-channel", "wavpack-sys", "opus-sys"]
 # Custom UAC 2.0 USB Audio (host-side DAC/AMP support)
 uac2 = ["rusb", "libusb1-sys"]
 
@@ -57,9 +57,6 @@ wavpack-sys = { path = "vendor/wavpack-sys", optional = true }
 # Opus decoder (FFI to libopus C library)
 opus-sys = { path = "vendor/opus-sys", optional = true }
 
-# Pitch shifter (FFI to SoundTouch C++ library)
-soundtouch-sys = { path = "vendor/soundtouch-sys", optional = true }
-
 [target.'cfg(target_os = "android")'.dependencies]
 oboe = { version = "0.6", features = ["java-interface"] }
 jni = "0.21"
@@ -75,7 +72,6 @@ ringbuf = "0.4"
 crossbeam-channel = "0.5"
 wavpack-sys = { path = "vendor/wavpack-sys" }
 opus-sys = { path = "vendor/opus-sys" }
-soundtouch-sys = { path = "vendor/soundtouch-sys" }
 
 [target.'cfg(any(target_os = "linux", target_os = "macos", target_os = "windows"))'.dependencies]
 notify = "6.1"
-- 
2.55.0

