From: fukiame <fukiame@proton.me>
Date: Sun, 26 Jul 2026 12:16:55 +0700
Subject: [PATCH] lib: settings: main: toLowerCase()

Signed-off-by: fukiame <fukiame@proton.me>

diff --git a/lib/features/settings/screens/settings_screen.dart b/lib/features/settings/screens/settings_screen.dart
index e1167090..2466d66a 100644
--- a/lib/features/settings/screens/settings_screen.dart
+++ b/lib/features/settings/screens/settings_screen.dart
@@ -236,14 +236,14 @@ class _CategoryTile extends StatelessWidget {
                   crossAxisAlignment: CrossAxisAlignment.start,
                   children: [
                     Text(
-                      title,
+                      title.toLowerCase(),
                       style: Theme.of(context).textTheme.titleSmall?.copyWith(
                         color: context.adaptiveTextPrimary,
                       ),
                     ),
                     const SizedBox(height: 2),
                     Text(
-                      subtitle,
+                      subtitle.toLowerCase(),
                       style: Theme.of(context).textTheme.bodySmall?.copyWith(
                         color: context.adaptiveTextTertiary,
                       ),
