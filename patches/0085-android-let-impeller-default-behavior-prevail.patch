From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: fukiame <fukiame@proton.me>
Date: Wed, 29 Jul 2026 01:02:28 +0700
Subject: [PATCH] android: let impeller default behavior prevail

Signed-off-by: fukiame <fukiame@proton.me>

diff --git a/android/app/src/main/AndroidManifest.xml b/android/app/src/main/AndroidManifest.xml
index c91b1122..0f35e80f 100644
--- a/android/app/src/main/AndroidManifest.xml
+++ b/android/app/src/main/AndroidManifest.xml
@@ -64,9 +64,6 @@
         <meta-data
             android:name="flutterEmbedding"
             android:value="2" />
-        <meta-data
-            android:name="io.flutter.embedding.android.EnableImpeller"
-            android:resource="@bool/enable_impeller" />
         <!-- Media Notification Service for background playback -->
         <service
             android:name=".MusicNotificationService"
-- 
