diff --git a/rust/Cargo.toml b/rust/Cargo.toml
index bdad920d..030a9a16 100644
--- a/rust/Cargo.toml
+++ b/rust/Cargo.toml
@@ -6,7 +6,6 @@ edition = "2021"
 [profile.release]
 strip = "symbols"
 opt-level = "s"
-lto = "thin"
 
 [lib]
 crate-type = ["cdylib", "staticlib"]
