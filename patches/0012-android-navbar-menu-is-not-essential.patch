From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: fukiame <fukiame@proton.me>
Date: Sat, 25 Jul 2026 12:47:07 +0700
Subject: [PATCH] android: navbar: menu is not essential

Signed-off-by: fukiame <fukiame@proton.me>

diff --git a/lib/models/nav_bar_config.dart b/lib/models/nav_bar_config.dart
index 86c5238..39df00a 100644
--- a/lib/models/nav_bar_config.dart
+++ b/lib/models/nav_bar_config.dart
@@ -27,7 +27,6 @@ class NavBarConfig {
   final bool showLabels;
 
   static const allButtons = [
-    NavBarButton.menu,
     NavBarButton.songs,
     NavBarButton.settings,
   ];
@@ -45,12 +44,11 @@ class NavBarConfig {
   List<NavBarButton> get orderedButtons => enabledButtons;
 
   bool get hasAllEssential =>
-      enabledButtons.contains(NavBarButton.menu) &&
       enabledButtons.contains(NavBarButton.songs) &&
       enabledButtons.contains(NavBarButton.settings);
 
   List<NavBarButton> get missingEssentials {
-    const essential = {NavBarButton.menu, NavBarButton.songs, NavBarButton.settings};
+    const essential = {NavBarButton.songs, NavBarButton.settings};
     return essential.where((b) => !enabledButtons.contains(b)).toList()
       ..sort((a, b) => a.pageIndex.compareTo(b.pageIndex));
   }
