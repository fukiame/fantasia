From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: fukiame <fukiame@proton.me>
Date: Fri, 31 Jul 2026 21:00:26 +0700
Subject: [PATCH] Revert "Disable release minification and shrink resources"

This reverts commit 323b3dee8f4ad95314bccf93a619688c769bf8d5.

diff --git a/android/app/build.gradle.kts b/android/app/build.gradle.kts
index 535a4b19..905bec2e 100644
--- a/android/app/build.gradle.kts
+++ b/android/app/build.gradle.kts
@@ -78,8 +78,6 @@ android {
     buildTypes {
         release {
             signingConfig = signingConfigs.getByName("release")
-            isMinifyEnabled = false
-            isShrinkResources = false
         }
     }
 }
diff --git a/android/gradle.properties b/android/gradle.properties
index 3a13d188..db7a19ef 100644
--- a/android/gradle.properties
+++ b/android/gradle.properties
@@ -6,7 +6,3 @@ android.defaults.buildfeatures.buildconfig=true
 android.builtInKotlin=false
 # This newDsl flag was added automatically by Flutter migrator
 android.newDsl=false
-# This builtInKotlin flag was added automatically by Flutter migrator
-android.builtInKotlin=false
-# This newDsl flag was added automatically by Flutter migrator
-android.newDsl=false
diff --git a/pubspec.yaml b/pubspec.yaml
index fb0b8e06..605bb383 100644
--- a/pubspec.yaml
+++ b/pubspec.yaml
@@ -16,7 +16,7 @@ publish_to: "none" # Remove this line if you wish to publish to pub.dev
 # https://developer.apple.com/library/archive/documentation/General/Reference/InfoPlistKeyReference/Articles/CoreFoundationKeys.html
 # In Windows, build-name is used as the major, minor, and patch parts
 # of the product and file versions while build-number is used as the build suffix.
-version: 0.20.5-beta.6+24
+version: 0.20.5-beta.6+23
 
 environment:
   sdk: ^3.10.4
-- 
