Date: Thu, 30 Jul 2026 16:29:30 +0700
Subject: [PATCH] lib: settings: move some around

Signed-off-by: fukiame <fukiame@proton.me>

diff --git a/lib/features/settings/screens/settings_screen.dart b/lib/features/settings/screens/settings_screen.dart
index e1467dec..d517a76e 100644
--- a/lib/features/settings/screens/settings_screen.dart
+++ b/lib/features/settings/screens/settings_screen.dart
@@ -66,16 +66,11 @@ class _SettingsScreenState extends State<SettingsScreen> {
                           onTap: () =>
                               _navigate(context, const QueueSettingsScreen()),
                         ),
-                        const SettingsDivider(),
-                        _CategoryTile(
-                          title: 'Player Layout',
-                          subtitle: 'Layout mode, sizing, and quick actions',
-                          onTap: () => _navigate(
-                            context,
-                            const PlayerLayoutSettingsScreen(),
-                          ),
-                        ),
-                        const SettingsDivider(),
+                      ],
+                    ),
+                    const SizedBox(height: AppConstants.spacingLg),
+                    SettingsCard(
+                      children: [
                         _CategoryTile(
                           title: 'Audio',
                           subtitle: 'UAC2 and equalizer',
@@ -96,9 +91,18 @@ class _SettingsScreenState extends State<SettingsScreen> {
                           ),
                         ),
                         const SettingsDivider(),
+                        _CategoryTile(
+                          title: 'Player Layout',
+                          subtitle: 'Layout mode, sizing, and quick actions',
+                          onTap: () => _navigate(
+                            context,
+                            const PlayerLayoutSettingsScreen(),
+                          ),
+                        ),
+                        const SettingsDivider(),
                         _CategoryTile(
                           title: 'Misc',
-                          subtitle: 'Show or hide home screen sections',
+                          subtitle: 'Home screen sections',
                           onTap: () => _navigate(
                             context,
                             const UiCustomizationSettingsScreen(),
diff --git a/lib/providers/equalizer_provider.dart b/lib/providers/equalizer_provider.dart
index f8c8997e..051fd3df 100644
--- a/lib/providers/equalizer_provider.dart
+++ b/lib/providers/equalizer_provider.dart
@@ -705,7 +705,7 @@ class EqualizerNotifier extends Notifier<EqualizerState> {
   }
 
   void setEnabled(bool value) {
-    state = state.copyWith(enabled: value);
+    state = state.copyWith(enabled: false);
     ref.read(eqGraphRepaintControllerProvider).bump();
     _syncToAudio();
   }
