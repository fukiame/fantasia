diff --git a/android/app/src/main/res/drawable/ic_launcher_fg.xml b/android/app/src/main/res/drawable/ic_launcher_fg.xml
new file mode 100644
index 00000000..02e04a5b
--- /dev/null
+++ b/android/app/src/main/res/drawable/ic_launcher_fg.xml
@@ -0,0 +1,28 @@
+<?xml version="1.0" encoding="utf-8"?>
+<vector xmlns:android="http://schemas.android.com/apk/res/android"
+    android:width="108dp"
+    android:height="108dp"
+    android:viewportWidth="108"
+    android:viewportHeight="108">
+    <path
+        android:fillColor="#FF000000"
+        android:strokeColor="#FF000000"
+        android:strokeWidth="4.5"
+        android:strokeLineCap="round"
+        android:strokeLineJoin="round"
+        android:pathData="M54 40v28"/>
+    <path
+        android:fillColor="#FF000000"
+        android:strokeColor="#FF000000"
+        android:strokeWidth="3"
+        android:strokeLineCap="round"
+        android:strokeLineJoin="round"
+        android:pathData="M47 37.19a0.81 0.81 0 1 0 0 1.62 0.81 0.81 0 1 0 0-1.62z"/>
