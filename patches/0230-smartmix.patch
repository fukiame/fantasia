-        icon: LucideIcons.moonStar,
-        colors: const [Color(0xFF172145), Color(0xFF5561D6)],
-        songs: afterHoursSongs,
-      ),
-    ];
-
-    return mixes.where((mix) => mix.songs.isNotEmpty).toList();
-  }
