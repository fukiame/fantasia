From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: fukiame <fukiame@proton.me>
Date: Mon, 17 Aug 2026 07:48:06 +0700
Subject: [PATCH] Revert "Increase jellyfin service timeout to 60s"

This reverts commit 8dc8b9d02fdb00e2561c57c90ddd9a8d1f8a70a7.

diff --git a/lib/services/sources/jellyfin_service.dart b/lib/services/sources/jellyfin_service.dart
index bdd33df56..b1955c761 100644
--- a/lib/services/sources/jellyfin_service.dart
+++ b/lib/services/sources/jellyfin_service.dart
@@ -106,9 +106,7 @@ class JellyfinService implements NetworkSourceService {
             'Pw': password,
           }),
         )
-        // ponytail: 60s ceiling for LDAP/SSO backends (Authentik et al);
-        // wrong-credential 401s still return as fast as the server sends them.
-        .timeout(const Duration(seconds: 60));
+        .timeout(const Duration(seconds: 15));
     if (response.statusCode != 200) {
       throw JellyfinNetworkException(
           'Authentication failed (HTTP ${response.statusCode})');
-- 
