@@ -2257,12 +2240,9 @@ class _ParametricEqViewState extends ConsumerState<_ParametricEqView> {
                           const SizedBox(width: AppConstants.spacingMd),
                       itemBuilder: (context, i) {
                         if (i == bands.length) {
-                          return _AddBandCard(
