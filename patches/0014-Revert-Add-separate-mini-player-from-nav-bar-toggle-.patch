Subject: [PATCH] Revert "Add separate mini player from nav bar toggle method"

This reverts commit 7905f9fcd343cbf0e82825e9164c545a6418d9cb.

diff --git a/lib/providers/app_preferences_provider.dart b/lib/providers/app_preferences_provider.dart
index e1209a6d..4b63147d 100644
--- a/lib/providers/app_preferences_provider.dart
+++ b/lib/providers/app_preferences_provider.dart
@@ -509,14 +509,6 @@ class AppPreferencesNotifier extends Notifier<AppPreferences> {
         .setMiniPlayerSwipeAction(value);
   }
 
-  Future<void> setSeparateMiniPlayerFromNavBar(bool value) async {
-    if (state.separateMiniPlayerFromNavBar == value) return;
-    state = state.copyWith(separateMiniPlayerFromNavBar: value);
-    await ref
-        .read(appPreferencesServiceProvider)
-        .setSeparateMiniPlayerFromNavBar(value);
-  }
-
   Future<void> setKeepPlayingOnQuit(bool value) async {
     if (state.keepPlayingOnQuit == value) return;
     state = state.copyWith(keepPlayingOnQuit: value);
