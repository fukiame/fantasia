From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: fukiame <fukiame@proton.me>
Date: Sat, 25 Jul 2026 13:59:21 +0700
Subject: [PATCH] lib: full_screen_player: more edge zone

Signed-off-by: fukiame <fukiame@proton.me>

diff --git a/lib/features/player/screens/full_player_screen.dart b/lib/features/player/screens/full_player_screen.dart
index bc9bc60b..18257ca4 100644
--- a/lib/features/player/screens/full_player_screen.dart
+++ b/lib/features/player/screens/full_player_screen.dart
@@ -69,7 +69,7 @@ class _FullPlayerScreenState extends ConsumerState<FullPlayerScreen>
   DateTime _lastDragUpdate = DateTime.now();
 
   // ponytail: edge zone wide enough to let Android's predictive back/home gestures win
-  static const double _backGestureEdgeWidth = 32.0;
+  static const double _backGestureEdgeWidth = 40.0;
   double _horizontalDragStartX = double.infinity;
 
   // Notifier for throttled position – only _WaveformLayer listens, so no setState needed.
