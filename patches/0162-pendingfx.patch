-  double _hzToT(double hz) {
-    final clamped = hz.clamp(_filterMinHz, _filterMaxHz).toDouble();
-    final logMin = math.log(_filterMinHz);
-    final logMax = math.log(_filterMaxHz);
-    return (math.log(clamped) - logMin) / (logMax - logMin);
