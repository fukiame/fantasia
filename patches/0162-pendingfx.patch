-  double _tToHz(double t) {
-    final logMin = math.log(_filterMinHz);
-    final logMax = math.log(_filterMaxHz);
-    final value = logMin + (logMax - logMin) * t.clamp(0.0, 1.0);
-    return math.exp(value);
-  }
