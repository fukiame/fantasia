-    if (_isTidal) {
-      await _testTidal(token);
-      return;
-    }
-    final entity = _draftEntity(token: token);
-    try {
-      final ok = await networkSourceServiceFor(_selectedProtocol).ping(entity);
-      if (!mounted) return;
-      setState(() {
-        _testing = false;
-        _testPassed = ok;
-      });
-    } catch (e) {
-      if (!mounted) return;
-      setState(() {
-        _testing = false;
-        _testPassed = false;
-        _testError = _humanError(e);
-      });
-    }
