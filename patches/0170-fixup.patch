diff --git a/rust/src/audio/engine.rs b/rust/src/audio/engine.rs
index 18c33c3a..4b685adf 100644
--- a/rust/src/audio/engine.rs
+++ b/rust/src/audio/engine.rs
@@ -2782,6 +2782,22 @@ fn queue_playback_source(
     let _ = event_tx.try_send(AudioEvent::NextTrackReady { path: queued_path });
 }
 
+fn handle_skip_to_next(
+    callback_data: &AudioCallbackData,
+    state: &Arc<AtomicU8>,
+    event_tx: &Sender<AudioEvent>,
+) {
+    let mut sources = callback_data.sources.lock();
+
+    if !sources.has_next() {
+        return;
+    }
+
+        // Immediate transition
+        sources.advance_to_next();
+        state.store(PlaybackState::Playing as u8, Ordering::Relaxed);
+}
+
 fn handle_seek(
     position_secs: f64,
     callback_data: &AudioCallbackData,
