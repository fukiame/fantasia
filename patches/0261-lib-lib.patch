                                    style: Theme.of(context).textTheme.bodyMedium
                                        ?.copyWith(
                                          color: context.adaptiveTextTertiary,
@@ -1374,7 +1372,7 @@ class _LibrarySettingsScreenState extends ConsumerState<LibrarySettingsScreen>
                               ),
                               color: context.adaptiveTextTertiary,
