@@ -1036,7 +1036,7 @@ class _LibrarySettingsScreenState extends ConsumerState<LibrarySettingsScreen>
                   crossAxisAlignment: CrossAxisAlignment.start,
                   children: [
                       Text(
-                        'Library',
+                        'library',
