From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: fukiame <fukiame@proton.me>
Date: Sun, 9 Aug 2026 01:27:56 +0700
Subject: [PATCH] Revert "Add cast button to player action enum"

This reverts commit e31ae7c9fee97814596fcfaf327120c477cc39d4.

diff --git a/lib/models/player_action_button.dart b/lib/models/player_action_button.dart
index c63a86eea..2f3022bb0 100644
--- a/lib/models/player_action_button.dart
+++ b/lib/models/player_action_button.dart
@@ -13,7 +13,6 @@ enum PlayerActionButton {
   usbVolume,
   equalizer,
   volume,
-  cast,
 }
 
 extension PlayerActionButtonX on PlayerActionButton {
@@ -41,8 +40,6 @@ extension PlayerActionButtonX on PlayerActionButton {
         return 'equalizer';
       case PlayerActionButton.volume:
         return 'volume';
-      case PlayerActionButton.cast:
-        return 'cast';
     }
   }
 
@@ -70,8 +67,6 @@ extension PlayerActionButtonX on PlayerActionButton {
         return 'Equalizer';
       case PlayerActionButton.volume:
         return 'Volume';
-      case PlayerActionButton.cast:
-        return 'Cast';
     }
   }
 
@@ -99,8 +94,6 @@ extension PlayerActionButtonX on PlayerActionButton {
         return LucideIcons.slidersHorizontal;
       case PlayerActionButton.volume:
         return LucideIcons.volume;
-      case PlayerActionButton.cast:
-        return LucideIcons.cast;
     }
   }
 
@@ -126,8 +119,6 @@ extension PlayerActionButtonX on PlayerActionButton {
         return PlayerActionButton.equalizer;
       case 'volume':
         return PlayerActionButton.volume;
-      case 'cast':
-        return PlayerActionButton.cast;
       case 'lyrics':
       default:
         return PlayerActionButton.lyrics;
