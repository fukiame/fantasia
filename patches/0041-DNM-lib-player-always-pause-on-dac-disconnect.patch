From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: fukiame <fukiame@proton.me>
Date: Sun, 26 Jul 2026 09:16:10 +0700
Subject: [PATCH] [DNM] lib: player: always pause on dac disconnect

Signed-off-by: fukiame <fukiame@proton.me>

diff --git a/lib/services/player_service.dart b/lib/services/player_service.dart
index 758cfcf6..4fe9fddd 100644
--- a/lib/services/player_service.dart
+++ b/lib/services/player_service.dart
@@ -564,8 +564,7 @@ class PlayerService {
   void _initUsbDacDisconnectHandling() {
     _usbDacDetachSubscription = _uac2Service.deviceDetachedEvents.listen((_) async {
       if (!isPlayingNotifier.value) return;
-      final enabled = await _appPreferencesService.getPauseOnUsbDacDisconnect();
-      if (enabled) pause();
+      pause();
     });
   }
 
