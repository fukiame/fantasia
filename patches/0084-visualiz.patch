-  double _frand(int n) {
-    var x = _songSeed ^ n;
-    x = ((x >> 16) ^ x) * 0x45d9f3b;
-    x = ((x >> 16) ^ x) * 0x45d9f3b;
-    x = (x >> 16) ^ x;
-    return (x & 0x7fffffff) / 0x7fffffff;
-  }
