-    }
-
-    if (!_isPlaying && !_useRealData && _controller.isAnimating) {
-      bool settled = true;
-      for (int i = 0; i < _barCount; i++) {
-        if ((_currentHeights[i] - _minHeight).abs() > 0.01) {
