-    final swell = math.sin(progress * math.pi * 6.0 + _songSeed) * 0.08 +
-        math.sin(progress * math.pi * 14.0 + _songSeed * 2.0) * 0.04;
-
-    return (energy + swell).clamp(0.1, 1.0);
-  }
