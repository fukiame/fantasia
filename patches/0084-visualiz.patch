-    var amplitude = 0.5;
-    var frequency = 1.0;
-    for (var i = 0; i < octaves; i++) {
-      value += amplitude * _noise2D(x * frequency, y * frequency);
-      amplitude *= 0.5;
-      frequency *= 2.0;
-    }
-    return value;
-  }
