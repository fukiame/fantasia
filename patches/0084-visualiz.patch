-    _frameCount++;
-
-    if (_useRealData) {
-      return;
-    }
-
-    for (int i = 0; i < _barCount; i++) {
-      switch (widget.movementMode) {
-        case 'smooth':
-          // Asymmetric attack / decay for a natural equalizer feel.
-          // Fast attack so beats register immediately, gentler decay
