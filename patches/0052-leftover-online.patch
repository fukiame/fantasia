-  bool _isDurationMatch(OnlineLyricsResult result) {
-    if (result.duration == null || widget.song.duration.inSeconds <= 0) {
-      return false;
-    }
-    final diff = (result.duration! - widget.song.duration.inSeconds).abs();
-    return diff <= 5;
-  }
