Date: Thu, 30 Jul 2026 15:30:17 +0700
Subject: [PATCH] lib: settings: move botttom bar always visible to bottom bar

Signed-off-by: fukiame <fukiame@proton.me>

diff --git a/lib/features/settings/screens/bottom_bar_settings_screen.dart b/lib/features/settings/screens/bottom_bar_settings_screen.dart
index 783119ae1..5efce7a95 100644
--- a/lib/features/settings/screens/bottom_bar_settings_screen.dart
+++ b/lib/features/settings/screens/bottom_bar_settings_screen.dart
@@ -16,6 +16,7 @@ class BottomBarSettingsScreen extends ConsumerWidget {
   Widget build(BuildContext context, WidgetRef ref) {
     final config = ref.watch(navBarConfigProvider);
     final appPreferences = ref.watch(appPreferencesProvider);
+    final navBarAlwaysVisible = ref.watch(navBarAlwaysVisibleProvider);
     final enabled = config.enabledButtons;
     final enabledCount = enabled.length;
     final hidden = config.hidden;
@@ -30,6 +31,18 @@ class BottomBarSettingsScreen extends ConsumerWidget {
           const SettingsSectionHeader('Auto Collapse'),
           SettingsCard(
             children: [
+              ToggleSetting(
+                icon: LucideIcons.panelBottom,
+                title: 'Bottom Bar Always Visible',
+                subtitle: 'Keep mini player and nav visible',
+                value: navBarAlwaysVisible,
+                onChanged: (value) {
+                  ref
+                      .read(navBarAlwaysVisibleProvider.notifier)
+                      .setAlwaysVisible(value);
+                },
+              ),
+              const SettingsDivider(),
               ToggleSetting(
                 icon: LucideIcons.timer,
                 title: 'Auto Collapse',
