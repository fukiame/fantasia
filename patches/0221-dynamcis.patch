-
-    pub fn process(&mut self, buf: &mut [f32], channels: usize) {
-        if channels == 0 || (!self.compressor.enabled && !self.limiter.enabled) {
-            return;
-        }
-
-        for frame in buf.chunks_exact_mut(channels) {
-            if self.compressor.enabled {
