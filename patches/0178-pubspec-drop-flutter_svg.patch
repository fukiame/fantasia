diff --git a/lib/widgets/common/vinyl_record.dart b/lib/widgets/common/vinyl_record.dart
index 74bbdb7e..4d606cdf 100644
--- a/lib/widgets/common/vinyl_record.dart
+++ b/lib/widgets/common/vinyl_record.dart
@@ -1,5 +1,4 @@
 import 'package:flutter/material.dart';
-import 'package:flutter_svg/flutter_svg.dart';
 
 /// A hand-painted vinyl record — concentric grooves, a tinted center label
 /// with the Flick logo, and a center hole. Sized at 104×104 by default.
@@ -24,14 +23,6 @@ class VinylRecord extends StatelessWidget {
           labelColor: color,
           grooveColor: color.withValues(alpha: 0.18),
         ),
-        child: Center(
-          child: SvgPicture.asset(
-            'assets/icons/flicklogo_svg.svg',
-            width: size * 0.19,
-            height: size * 0.23,
-            colorFilter: const ColorFilter.mode(Colors.white, BlendMode.srcIn),
-          ),
-        ),
       ),
     );
   }
