diff --git a/lib/app/app.dart b/lib/app/app.dart
index 1a10cfa6..1ee1212e 100644
--- a/lib/app/app.dart
+++ b/lib/app/app.dart
@@ -526,11 +526,8 @@ class _MainShellState extends ConsumerState<MainShell>
 
                 // Persistent Background - always on for all bottom-bar screens
                 Positioned.fill(
-                  child: Consumer(
-                    builder: (context, ref, _) {
-                      final currentSong = ref.watch(currentSongProvider);
-                      return AmbientBackground(song: currentSong);
-                    },
+                  child: DecoratedBox(
+                    decoration: BoxDecoration(color: Color(0xFF000000)),
                   ),
                 ),
 
diff --git a/lib/widgets/common/blurred_song_background.dart b/lib/widgets/common/blurred_song_background.dart
index e7bfdd90..e38567e8 100644
--- a/lib/widgets/common/blurred_song_background.dart
+++ b/lib/widgets/common/blurred_song_background.dart
@@ -19,10 +19,9 @@ class BlurredSongBackground extends ConsumerWidget {
       children: [
         const Positioned.fill(
           child: DecoratedBox(
-            decoration: BoxDecoration(gradient: AppColors.backgroundGradient),
+            decoration: BoxDecoration(color: Color(0xFF000000)),
           ),
         ),
-        Positioned.fill(child: AmbientBackground(song: currentSong)),
         Positioned.fill(child: child),
       ],
     );
