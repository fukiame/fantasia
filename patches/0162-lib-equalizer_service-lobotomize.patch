Subject: [PATCH] lib: equalizer_service: lobotomize

Signed-off-by: fukiame <fukiame@proton.me>

diff --git a/lib/services/equalizer_service.dart b/lib/services/equalizer_service.dart
index 8f67eb58..c09ccd07 100644
--- a/lib/services/equalizer_service.dart
+++ b/lib/services/equalizer_service.dart
@@ -9,6 +9,7 @@ EqualizerState _lastRequestedState = EqualizerState.initial();
 /// Rust engine: graphic EQ, dynamics, and creative FX are applied natively.
 /// just_audio on Android: uses native AudioEffect counterparts where available.
 Future<void> applyEqualizer(EqualizerState state) async {
+  return;
   _lastRequestedState = _snapshotState(state);
 
   final useGraphic = state.mode == EqMode.graphic;
