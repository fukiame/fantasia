-        overlayColor: widget.overlayColor,
-      ),
-      child: Slider(
-        value: _currentValue,
-        min: widget.min,
-        max: widget.max,
-        onChangeStart: (_) {
-          _controller.stop();
-          _isDragging = true;
-        },
-        onChangeEnd: (_) => _isDragging = false,
-        onChanged: widget.onChanged != null
-            ? (v) {
-                setState(() => _currentValue = v);
-                widget.onChanged!(v);
-              }
-            : null,
-      ),
-    );
-  }
-}
