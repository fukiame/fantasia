From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: fukiame <fukiame@proton.me>
Date: Wed, 5 Aug 2026 23:07:31 +0700
Subject: [PATCH] Revert "Add streamDescriptor override to UpnpService"

This reverts commit c49c4ef57776d7c55b882b5704b65b25699902ee.

diff --git a/lib/services/sources/upnp_service.dart b/lib/services/sources/upnp_service.dart
index 94f19cbcd..9cf3cddb5 100644
--- a/lib/services/sources/upnp_service.dart
+++ b/lib/services/sources/upnp_service.dart
@@ -210,17 +210,6 @@ class UpnpService implements NetworkSourceService {
         extension: extension);
   }
 
-  @override
-  Future<({String url, Map<String, String> headers})?> streamDescriptor(
-    NetworkServerEntity server,
-    String remoteId, {
-    String? extension,
-  }) async {
-    // remoteId is the url-encoded <res> stream URL. DLNA MediaServer spec
-    // mandates byte-range support; no auth on LAN by convention.
-    return (url: Uri.decodeFull(remoteId), headers: const <String, String>{});
-  }
-
   // --- Library walk -------------------------------------------------------
 
   @override
-- 
