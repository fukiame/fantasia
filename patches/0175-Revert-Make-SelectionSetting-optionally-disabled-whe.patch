From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: fukiame <fukiame@proton.me>
Date: Sun, 2 Aug 2026 19:28:41 +0700
Subject: [PATCH] Revert "Make SelectionSetting optionally disabled when onTap
 is null"

This reverts commit bf1c2474ac7b33f9ac799b21806b31c8e43e1241.

diff --git a/lib/features/settings/widgets/settings_widgets.dart b/lib/features/settings/widgets/settings_widgets.dart
index a02fea632..7c2ab8f6d 100644
--- a/lib/features/settings/widgets/settings_widgets.dart
+++ b/lib/features/settings/widgets/settings_widgets.dart
@@ -217,7 +217,7 @@ class NavigationSetting extends StatelessWidget {
   }
 }
 
-/// Row with a radio-like selection indicator. Disabled when [onTap] is null.
+/// Row with a radio-like selection indicator.
 class SelectionSetting extends StatelessWidget {
   const SelectionSetting({
     super.key,
@@ -225,31 +225,29 @@ class SelectionSetting extends StatelessWidget {
     required this.title,
     required this.subtitle,
     required this.selected,
-    this.onTap,
+    required this.onTap,
   });
 
   final IconData icon;
   final String title;
   final String subtitle;
   final bool selected;
-  final VoidCallback? onTap;
+  final VoidCallback onTap;
 
   @override
   Widget build(BuildContext context) {
     return Material(
       color: Colors.transparent,
       child: InkWell(
-        onTap: onTap,
+        onTap: () {
+          AppHaptics.tap();
+          onTap();
+        },
         child: Padding(
           padding: const EdgeInsets.all(AppConstants.spacingLg),
           child: Row(
             children: [
-              _SettingsIcon(
-                icon: icon,
-                color: onTap == null
-                    ? context.adaptiveTextTertiary
-                    : null,
-              ),
+              _SettingsIcon(icon: icon),
               const SizedBox(width: AppConstants.spacingMd),
               Expanded(
                 child: Column(
@@ -258,9 +256,7 @@ class SelectionSetting extends StatelessWidget {
                     Text(
                       title,
                       style: Theme.of(context).textTheme.titleMedium?.copyWith(
-                        color: onTap == null
-                            ? context.adaptiveTextTertiary
-                            : context.adaptiveTextPrimary,
+                        color: context.adaptiveTextPrimary,
                       ),
                     ),
                     const SizedBox(height: 2),
@@ -277,11 +273,9 @@ class SelectionSetting extends StatelessWidget {
                 selected
                     ? Icons.check_circle_rounded
                     : Icons.radio_button_unchecked,
-                color: onTap == null
-                    ? context.adaptiveTextTertiary
-                    : selected
-                        ? context.adaptiveTextPrimary
-                        : context.adaptiveTextTertiary,
+                color: selected
+                    ? context.adaptiveTextPrimary
+                    : context.adaptiveTextTertiary,
                 size: 20,
               ),
             ],
-- 
2.55.0

