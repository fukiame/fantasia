diff --git a/lib/features/settings/screens/lyrics_settings_screen.dart b/lib/features/settings/screens/lyrics_settings_screen.dart
index 0d966e38c..218091767 100644
--- a/lib/features/settings/screens/lyrics_settings_screen.dart
