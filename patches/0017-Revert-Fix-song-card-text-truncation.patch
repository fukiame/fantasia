From: fukiame <fukiame@proton.me>
Date: Fri, 4 Sep 2026 07:22:30 +0700
Subject: [PATCH] Revert "Fix song card text truncation"

This reverts commit 782a4851d0fb2366df54fdb96ef4a4927177f550.

diff --git a/lib/features/songs/widgets/song_card.dart b/lib/features/songs/widgets/song_card.dart
index 85a1a504c..2f50e49a2 100644
--- a/lib/features/songs/widgets/song_card.dart
+++ b/lib/features/songs/widgets/song_card.dart
@@ -5,6 +5,7 @@ import 'package:flick/core/theme/app_colors.dart';
 import 'package:flick/core/constants/app_constants.dart';
 import 'package:flick/core/utils/app_haptics.dart';
 import 'package:flick/models/song.dart';
+import 'package:flick/widgets/common/marquee_widget.dart';
 import 'package:flick/widgets/common/cached_image_widget.dart';
 import 'package:flick/widgets/common/flick_artwork_placeholder.dart';
 
@@ -401,10 +402,7 @@ class _SongCardState extends State<SongCard> {
         if (isSelected)
           SizedBox(
             height: 24,
-            width: double.infinity,
-            child: FittedBox(
-              fit: BoxFit.scaleDown,
-              alignment: Alignment.centerLeft,
+            child: MarqueeWidget(
               child: Text(
                 widget.song.title,
                 style: const TextStyle(
@@ -413,9 +411,6 @@ class _SongCardState extends State<SongCard> {
                   color: Colors.white,
                   letterSpacing: 0.2,
                 ),
-                maxLines: 1,
-                softWrap: false,
-                overflow: TextOverflow.visible,
               ),
             ),
           )
