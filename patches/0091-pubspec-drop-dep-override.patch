From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: fukiame <fukiame@proton.me>
Date: Wed, 29 Jul 2026 22:41:59 +0700
Subject: [PATCH] pubspec: drop dep override

without riverpod_lint and riverpod_generator, no conflicts

Signed-off-by: fukiame <fukiame@proton.me>

diff --git a/pubspec.yaml b/pubspec.yaml
index fc91f2a8..b9eea4f5 100644
--- a/pubspec.yaml
+++ b/pubspec.yaml
@@ -86,12 +86,6 @@ flutter_launcher_icons:
   adaptive_icon_foreground: "assets/icons/reverse_flick_logo_transparent.png"
   adaptive_icon_monochrome: "assets/icons/reverse_flick_logo.png"
 
-# Resolve conflict between riverpod_generator and isar_community_generator
-# while keeping build_runner compatible with the cached toolchain versions.
-dependency_overrides:
-  analyzer: 8.1.1
-  dart_style: 3.1.2
-
 flutter:
   uses-material-design: true
 
