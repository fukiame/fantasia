-    for (final row in rows) {
-      final line = row.trimRight();
-      if (line.trim().isEmpty) continue;
-
-      final offsetMatch = offsetPattern.firstMatch(line);
-      if (offsetMatch != null) {
-        offsetMs = int.tryParse(offsetMatch.group(1) ?? '') ?? offsetMs;
-        continue;
