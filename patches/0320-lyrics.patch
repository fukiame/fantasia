-    ).firstMatch(trimmed);
-    if (match == null) return null;
-
-    final minutes = int.tryParse(match.group(1) ?? '');
-    final seconds = int.tryParse(match.group(2) ?? '');
-    if (minutes == null || seconds == null) return null;
