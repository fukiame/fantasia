From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: fukiame <fukiame@proton.me>
Date: Fri, 31 Jul 2026 23:28:45 +0700
Subject: [PATCH] rust: audio: dont multiply if 1

Signed-off-by: fukiame <fukiame@proton.me>

diff --git a/rust/src/audio/engine.rs b/rust/src/audio/engine.rs
index 59de8820..8159d6c7 100644
--- a/rust/src/audio/engine.rs
+++ b/rust/src/audio/engine.rs
@@ -2202,9 +2202,11 @@ pub(crate) fn audio_callback(
         if read < output.len() {
             output[read..].fill(0.0);
         }
+        if gain != 1.0 {
         for sample in output[..read].iter_mut() {
             *sample *= gain;
         }
+        }
         return;
     }
 
