-    if ((newOffset - _scrollOffset.value).abs() > 0.001) {
-      _scrollOffset.value = newOffset;
-      if (!_isScrolling) {
-        setState(() {
-          _isScrolling = true;
-          _lastScrollTime = DateTime.now();
