@@ -1301,8 +1301,8 @@ class _LibrarySettingsScreenState extends ConsumerState<LibrarySettingsScreen>
                               children: [
                                 Text(
                                   _isXiaomiDevice
-                                      ? 'Disable Battery Optimization (Recommended)'
