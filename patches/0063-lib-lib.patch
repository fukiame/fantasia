diff --git a/lib/features/settings/screens/library_settings_screen.dart b/lib/features/settings/screens/library_settings_screen.dart
index 33fe9ff5..91206ae6 100644
--- a/lib/features/settings/screens/library_settings_screen.dart
+++ b/lib/features/settings/screens/library_settings_screen.dart
@@ -992,7 +992,7 @@ class _LibrarySettingsScreenState extends ConsumerState<LibrarySettingsScreen>
                   crossAxisAlignment: CrossAxisAlignment.start,
                   children: [
                     Text(
-                      'Library',
+                      'library',
                       style: Theme.of(context).textTheme.titleSmall?.copyWith(
                         color: context.adaptiveTextPrimary,
                       ),
@@ -1144,13 +1144,13 @@ class _LibrarySettingsScreenState extends ConsumerState<LibrarySettingsScreen>
                       crossAxisAlignment: CrossAxisAlignment.start,
                       children: [
                         Text(
-                          'Scanning Settings',
+                          'scanning settings',
                           style: Theme.of(context).textTheme.titleSmall
                               ?.copyWith(color: context.adaptiveTextPrimary),
                         ),
                         const SizedBox(height: 2),
                         Text(
-                          'Filter files, size limits, and playlist import options',
+                          'filters, playlist import, deep scan, etc',
